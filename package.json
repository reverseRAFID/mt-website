{
  "name": "mongol-tori-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "payload": "node --env-file-if-exists=.env.local ./node_modules/payload/bin.js",
    "generate:types": "npm run payload -- generate:types",
    "generate:importmap": "npm run payload -- generate:importmap",
    "check:privacy": "node scripts/check-shop-privacy.mjs; s=$?; node scripts/check-donation-privacy.mjs; d=$?; exit $((s|d))",
    "check:shop": "node scripts/check-shop-privacy.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.1.0",
    "@payloadcms/db-mongodb": "^3.86.0",
    "@payloadcms/email-resend": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "@payloadcms/ui": "^3.86.0",
    "@portabletext/react": "^7.0.1",
    "@sanity/client": "^7.22.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/webhook": "^4.0.4",
    "@tailwindcss/postcss": "^4.3.0",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "payload": "^3.86.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.0",
    "sharp": "^0.35.3",
    "styled-components": "^6.4.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}
