# ============================================================
# BRACU Mongol-Tori — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# ── Site ─────────────────────────────────────────────────────

# The origin this deployment answers on. Used for canonical URLs, Open Graph
# images, order emails — and, importantly, by Payload to build the URL of every
# uploaded file.
#
# IT MUST MATCH THE ENVIRONMENT IT RUNS IN. A dev server configured with the
# production URL will render <img> tags pointing at images that only exist in
# production, and next/image will refuse them as an unconfigured host.
#
#   local       http://localhost:3000
#   production  https://bracumongoltori.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# PAYLOAD CMS + MONGODB
# ============================================================

# MongoDB connection string.
#
#   local       `npm run db:up` starts a single-node replica set on 27017
#   production  a MongoDB Atlas URI
#
# It MUST be a replica set, not a standalone server. Placing an order reserves
# stock and writes the order in one transaction, and a standalone mongod cannot
# start one — it will accept every read and then fail every checkout.
DATABASE_URI=mongodb://localhost:27017/mongoltori?replicaSet=rs0

# Signs admin session tokens and encrypts stored secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it logs every CMS user out. It must be set, and must differ between
# environments.
PAYLOAD_SECRET=

# ── Cloudinary (file storage + image delivery) ───────────────
#
# REQUIRED IN PRODUCTION. Without credentials Payload writes uploads to the
# local filesystem, which is correct locally and wrong on Vercel, where the
# filesystem is replaced on every deploy — every image would vanish at the next
# push, with no error to notice.
#
# Cloudinary is also the image pipeline, not just storage: every size is a URL
# transformation (see src/lib/cms/media.ts), and next/image delegates to it via
# a custom loader. Nothing is resized at upload.
#
# Either the single URL form, copied from the Cloudinary dashboard:
CLOUDINARY_URL=

# …or the three parts separately. Use one form or the other, not both.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# EMAIL
# ============================================================

# Resend — order confirmations, status updates, and admin password resets.
#
# OPTIONAL BY DESIGN. When unset, orders are still accepted and stored; the
# email is skipped and the order is flagged `emailStatus: skipped` so the team
# can follow up by hand. An email failure must never lose an order.
RESEND_API_KEY=

# The From address. Its domain must be verified in Resend or every send fails.
# Format: "Display Name <address@domain>".
SHOP_FROM_EMAIL=BRACU Mongol-Tori <shop@bracumongoltori.com>

# ============================================================
# ONE-OFF MIGRATION (scripts/migrate-from-sanity.ts)
# ============================================================
# Only needed to re-run the import from the old Sanity dataset. The site itself
# does not read any of these, and @sanity/client is a devDependency — nothing
# below ships to production.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# A Viewer token is enough; the migration only ever reads.
SANITY_API_READ_TOKEN=
