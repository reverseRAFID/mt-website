# ============================================================
# BRACU Mongol-Tori — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# Sanity CMS
# Get these from: https://www.sanity.io/manage → your project
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token — REQUIRED. Without it the site cannot read a private
# dataset and cannot accept form submissions.
#   • Reads  — every page fetch (the dataset is PRIVATE; see docs/privacy-runbook.md)
#   • Writes — apply-form `application` docs, crowdfunding `donation` docs, and
#              shop `order` docs (which also decrement product stock)
# Create at: sanity.io/manage → API → Tokens, with "Editor" permissions.
# Must be set in Vercel for BOTH Production and Preview.
SANITY_API_TOKEN=

# Optional: a separate read-only ("Viewer") token used for page reads. Falls
# back to SANITY_API_TOKEN when unset. Recommended — it keeps the Editor token
# off the read path.
SANITY_API_READ_TOKEN=

# Site URL (used for OG images, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://bracumongoltori.com

# Neon Postgres — legacy / optional. No longer used by the apply form
# (submissions now go to Sanity). Safe to leave unset.
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# ============================================================
# MERCH SHOP
# ============================================================

# Resend — transactional email for order invoices and status updates.
# Get a key at: https://resend.com → API Keys
#
# OPTIONAL BY DESIGN. When unset, orders are still accepted and stored; the
# email is skipped and the order is flagged `emailStatus: 'skipped'` so the
# team can follow up by hand. An email failure must never lose an order.
RESEND_API_KEY=

# The From address on shop email. The domain must be verified in Resend, or
# every send fails. Format: "Display Name <address@domain>".
SHOP_FROM_EMAIL=BRACU Mongol-Tori <shop@bracumongoltori.com>

# Sanity webhook signing secret — verifies that order status-change callbacks
# to /api/shop/webhook genuinely came from Sanity. Without it the route rejects
# every request (fail closed), so status emails and cancellation stock-restores
# stop working.
#
# Set the SAME value in both places:
#   1. sanity.io/manage → API → Webhooks → your webhook → Secret
#   2. here / Vercel env
# Setup steps: docs/shop-runbook.md
SANITY_WEBHOOK_SECRET=

# ============================================================
# PAYLOAD CMS + MONGODB
# ============================================================

# MongoDB connection string. Local dev: `npm run db:up` starts a single-node
# replica set on 27017 (docker-compose.yml). Production: a MongoDB Atlas URI.
#
# It MUST be a replica set, not a standalone server. The shop reserves stock and
# writes the order in one transaction, and standalone mongod cannot start one —
# a standalone database will accept every read and then fail every checkout.
DATABASE_URI=mongodb://localhost:27017/mongoltori?replicaSet=rs0

# Signs admin session tokens and encrypts stored secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it logs every CMS user out. It must be set, and must differ between
# environments.
PAYLOAD_SECRET=

# Vercel Blob — object storage for uploads in production. Payload writes
# uploads to the local filesystem when this is unset, which is correct for local
# development and WRONG on Vercel, where the filesystem is wiped on every
# deploy. Create the store in the Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=

# IMPORTANT: this must match the environment it runs in, not always production.
# Payload builds upload URLs from it, so a dev server configured with the
# production URL will render <img> tags pointing at images that only exist in
# production. Use http://localhost:3000 locally.
